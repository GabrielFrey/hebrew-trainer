{
  "expo": {
    "name": "Biti Hebrew",
    "slug": "biti-ivrit",
    "scheme": "biti",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#EEF2F7",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#101820"
          }
        }
      ],
      "expo-status-bar"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDisplayName": "Biti Hebrew"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#184A82"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Biti Hebrew",
      "shortName": "Biti",
      "themeColor": "#184A82",
      "backgroundColor": "#EEF2F7"
    },
    "locales": {
      "en": "./locales/en.json",
      "ru": "./locales/ru.json",
      "he": "./locales/he.json",
      "uk": "./locales/uk.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}

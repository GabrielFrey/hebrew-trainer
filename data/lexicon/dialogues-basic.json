{"dialogues": [{"id": "basic-numbers-d0", "level": "basic", "theme": "numbers", "title": "На кассе", "titleEn": "At the till", "lines": [{"speaker": "a", "nikud": "כַּמָּה זֶה עוֹלֶה בְּיַחַד?", "hebrew": "כמה זה עולה ביחד?", "transcription": "kamma ze ole beyakhad?", "ru": "Сколько это всё вместе?", "en": "How much is that altogether?"}, {"speaker": "b", "nikud": "שִׁבְעִים וּשְׁנַיִם שְׁקָלִים.", "hebrew": "שבעים ושנים שקלים.", "transcription": "shivim ushnayim shekalim.", "ru": "Семьдесят два шекеля.", "en": "Seventy-two shekels."}], "replies": [{"nikud": "יֵשׁ לִי רַק חֲמִשִּׁים מְזוּמָן. אֶפְשָׁר בְּכַרְטִיס?", "ru": "Наличных только пятьдесят. Можно картой?", "en": "I only have fifty in cash. Card okay?", "correct": true}, {"nikud": "אֲנִי גָּר בַּצָּפוֹן.", "ru": "Я живу на севере.", "en": "I live in the north.", "correct": false}, {"nikud": "הַכֶּלֶב בַּחוּץ.", "ru": "Собака на улице.", "en": "The dog is outside.", "correct": false}]}, {"id": "basic-family-d0", "level": "basic", "theme": "family", "title": "Кто заберёт", "titleEn": "Who's picking up", "lines": [{"speaker": "a", "nikud": "מִי לוֹקֵחַ אֶת הַיְּלָדִים הַיּוֹם?", "hebrew": "מי לוקח את הילדים היום?", "transcription": "mi lokekha et haladim haom?", "ru": "Кто сегодня забирает детей?", "en": "Who's picking up the kids today?"}, {"speaker": "b", "nikud": "אֲנִי. אַבָּא עוֹבֵד עַד שֶׁבַע.", "hebrew": "אני. אבא עובד עד שבע.", "transcription": "ani. aba oved ad sheva.", "ru": "Я. Папа работает до семи.", "en": "I am. Dad works until seven."}], "replies": [{"nikud": "טוֹב, אֲנִי אָכִין אֹכֶל.", "ru": "Хорошо, я приготовлю еду.", "en": "Good, I'll make food.", "correct": true}, {"nikud": "כַּרְטִיס אָדֹם.", "ru": "Красный билет.", "en": "A red ticket.", "correct": false}, {"nikud": "יֵשׁ שֶׁלֶג.", "ru": "Снег.", "en": "There's snow.", "correct": false}]}, {"id": "basic-food-d0", "level": "basic", "theme": "food", "title": "Заказ за столом", "titleEn": "Ordering at the table", "lines": [{"speaker": "a", "nikud": "מָה אַתְּ לוֹקַחַת?", "hebrew": "מה את לוקחת?", "transcription": "ma at lokakhat?", "ru": "Что берёшь?", "en": "What are you having?"}, {"speaker": "b", "nikud": "שׁוּעִית וְעָלִים. וְאַתָּה?", "hebrew": "שועית ועלים. ואתה?", "transcription": "shuit vealim. veata?", "ru": "Шакшуку и салат. А ты?", "en": "Shakshuka and a salad. And you?"}], "replies": [{"nikud": "פָּלָאפֶל וְעָלִים, בְּלִי חָרִיף.", "ru": "Фалафель и салат, без острого.", "en": "Falafel and salad, no hot sauce.", "correct": true}, {"nikud": "הָרַכֶּבֶת בְּתֵשַׁע.", "ru": "Поезд в девять.", "en": "The train is at nine.", "correct": false}, {"nikud": "הוּא אָח שֶׁלִּי.", "ru": "Он мой брат.", "en": "He's my brother.", "correct": false}]}, {"id": "basic-verbs-d0", "level": "basic", "theme": "verbs", "title": "Помоги закрыть", "titleEn": "Help me finish", "lines": [{"speaker": "a", "nikud": "אַתָּה יָכוֹל לַעֲזֹר לִי לִסְגֹּר אֶת זֶה?", "hebrew": "אתה יכול לעזר לי לסגר את זה?", "transcription": "ata yakhol laazor li lisgor et ze?", "ru": "Можешь помочь мне это закрыть?", "en": "Can you help me finish this?"}, {"speaker": "b", "nikud": "כֵּן, תֵּן לִי שְׁנִיָּה לִגְמֹר שִׂיחָה.", "hebrew": "כן, תן לי שניה לגמר שיחה.", "transcription": "ken, ten li sheniya ligmor sikha.", "ru": "Да, дай секунду закончить разговор.", "en": "Yes, give me a second to finish a call."}], "replies": [{"nikud": "בְּסֵדֶר, אֲנִי מְחַכֶּה בַּמִּטְבָּח.", "ru": "Ладно, жду на кухне.", "en": "Okay, I'll wait in the kitchen.", "correct": true}, {"nikud": "זֶה כָּתוֹם.", "ru": "Это оранжевое.", "en": "That's orange.", "correct": false}, {"nikud": "יֵשׁ לִי כֶּלֶב.", "ru": "У меня есть собака.", "en": "I have a dog.", "correct": false}]}, {"id": "basic-people-d0", "level": "basic", "theme": "people", "title": "Сосед", "titleEn": "The neighbor", "lines": [{"speaker": "a", "nikud": "אַתָּה מַכִּיר אֶת הַשָּׁכֵן מִמּוּל?", "hebrew": "אתה מכיר את השכן ממול?", "transcription": "ata makir et hashakhen mimmul?", "ru": "Знаешь соседа н
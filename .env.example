# Biti Ivrit local configuration. Copy to .env and adjust.
# Never put real secrets in the repository, git bundles, or logs.

BITI_ENV=development
BITI_DEMO_MODE=true
# Startup fails if BITI_DEMO_MODE=true and BITI_ENV=production.

BITI_SECRET_KEY=replace-with-a-long-random-dev-only-string
BITI_ACCESS_TOKEN_MINUTES=20
BITI_REFRESH_TOKEN_DAYS=14

# SQLite is the documented local fallback for this workspace.
# Compose uses PostgreSQL. Do not enable SQLite in production.
BITI_DATABASE_URL=sqlite:///./data/local/biti.sqlite
# BITI_DATABASE_URL=postgresql+psycopg://biti:biti@127.0.0.1:5432/biti

BITI_REDIS_URL=redis://127.0.0.1:6379/0
BITI_CORS_ORIGINS=http://127.0.0.1:43181,http://localhost:43181

# OIDC (Keycloak in Compose). Leave empty to disable the live OIDC login route.
BITI_OIDC_ISSUER=
BITI_OIDC_CLIENT_ID=biti-web
BITI_OIDC_CLIENT_SECRET=
BITI_OIDC_REDIRECT_URI=http://127.0.0.1:43181/auth/callback

# TTS — honest unavailable when unset. Never invent audio.
BITI_TTS_PROVIDER=
BITI_TTS_API_KEY=
BITI_TTS_BASE_URL=
BITI_TTS_VOICE=he-IL-standard

# Speech assessment — honest unavailable when unset.
BITI_SPEECH_PROVIDER=
BITI_SPEECH_API_KEY=

# OpenAI-compatible tutor. Empty = honest unavailable + static-rule fallback.
BITI_LLM_BASE_URL=
BITI_LLM_API_KEY=
BITI_LLM_MODEL=gpt-4.1-mini
BITI_LLM_DAILY_TOKEN_BUDGET=80000
BITI_LLM_TIMEOUT_SECONDS=12

# Object storage (MinIO in Compose). Optional locally.
BITI_S3_ENDPOINT=
BITI_S3_ACCESS_KEY=
BITI_S3_SECRET_KEY=
BITI_S3_BUCKET=biti-audio

# Content pipeline
BITI_PIPELINE_CRON=0 3 * * 1
BITI_HTTP_USER_AGENT=BitiIvritBot/0.1 (+https://example.invalid/biti-ivrit)

NEXT_PUBLIC_API_URL=http://127.0.0.1:43180
EXPO_PUBLIC_API_URL=http://127.0.0.1:43180

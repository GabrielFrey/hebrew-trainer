{"dialogues": [{"id": "elementary-greetings-d0", "level": "elementary", "theme": "greetings", "title": "Знакомство", "titleEn": "Meeting someone", "lines": [{"speaker": "a", "nikud": "שָׁלוֹם, מָה שִׁמְךָ?", "hebrew": "שלום, מה שמך?", "transcription": "shalom, ma shimkha?", "ru": "Привет, как тебя зовут?", "en": "Hi, what's your name?"}, {"speaker": "b", "nikud": "אֲנִי דָּנִי. וְאַתָּה?", "hebrew": "אני דני. ואתה?", "transcription": "ani dani. veata?", "ru": "Я Дани. А ты?", "en": "I'm Dani. And you?"}], "replies": [{"nikud": "אֲנִי נוֹעַם, נָעִים מְאֹד.", "ru": "Я Ноам, очень приятно.", "en": "I'm Noam, nice to meet you.", "correct": true}, {"nikud": "לֹא, תּוֹדָה.", "ru": "Нет, спасибо.", "en": "No, thanks.", "correct": false}, {"nikud": "הַחֶשְׁבּוֹן בְּבַקָּשָׁה.", "ru": "Счёт, пожалуйста.", "en": "The bill, please.", "correct": false}]}, {"id": "elementary-core-d0", "level": "elementary", "theme": "core", "title": "Да и нет", "titleEn": "Yes and no", "lines": [{"speaker": "a", "nikud": "אַתָּה רוֹצֶה קָפֶה?", "hebrew": "אתה רוצה קפה?", "transcription": "ata rotse kafe?", "ru": "Хочешь кофе?", "en": "Do you want coffee?"}, {"speaker": "b", "nikud": "כֵּן, בְּבַקָּשָׁה. וְלָךְ?", "hebrew": "כן, בבקשה. ולך?", "transcription": "ken, bevakasha. velakh?", "ru": "Да, пожалуйста. А тебе?", "en": "Yes, please. And you?"}], "replies": [{"nikud": "גַּם אֲנִי, תּוֹדָה.", "ru": "Мне тоже, спасибо.", "en": "Me too, thanks.", "correct": true}, {"nikud": "אֵיפֹה הַתַּחֲנָה?", "ru": "Где остановка?", "en": "Where is the station?", "correct": false}, {"nikud": "אֲנִי רוֹפֵא.", "ru": "Я врач.", "en": "I'm a doctor.", "correct": false}]}, {"id": "elementary-verbs-d0", "level": "elementary", "theme": "verbs", "title": "Что ты делаешь", "titleEn": "What are you doing", "lines": [{"speaker": "a", "nikud": "מָה אַתָּה עוֹשֶׂה עַכְשָׁו?", "hebrew": "מה אתה עושה עכשו?", "transcription": "ma ata ose akhshav?", "ru": "Что ты сейчас делаешь?", "en": "What are you doing now?"}, {"speaker": "b", "nikud": "אֲנִי קוֹרֵא. וְאַתָּה?", "hebrew": "אני קורא. ואתה?", "transcription": "ani kore. veata?", "ru": "Я читаю. А ты?", "en": "I'm reading. And you?"}], "replies": [{"nikud": "אֲנִי כּוֹתֵב הוֹדָעָה.", "ru": "Пишу сообщение.", "en": "I'm writing a message.", "correct": true}, {"nikud": "שְׁנֵי כַּרְטִיסִים.", "ru": "Два билета.", "en": "Two tickets.", "correct": false}, {"nikud": "בְּשָׁלוֹשׁ.", "ru": "В три.", "en": "At three.", "correct": false}]}, {"id": "elementary-clothes-d0", "level": "elementary", "theme": "clothes", "title": "Что надеть", "titleEn": "What to wear", "lines": [{"speaker": "a", "nikud": "קַר בַּחוּץ. תִּלְבַּשׁ מְעִיל?", "hebrew": "קר בחוץ. תלבש מעיל?", "transcription": "kar bakhuts. tilbash meil?", "ru": "На улице холодно. Наденешь пальто?", "en": "It's cold outside. Will you wear a coat?"}, {"speaker": "b", "nikud": "כֵּן. אַתָּה רוֹאֶה אֶת הַכּוֹבַע שֶׁלִּי?", "hebrew": "כן. אתה רואה את הכובע שלי?", "transcription": "ken. ata roe et hakova shelli?", "ru": "Да. Видишь мою шапку?", "en": "Yes. Do you see my hat?"}], "replies": [{"nikud": "הִיא עַל הַכִּסֵּא.", "ru": "Она на стуле.", "en": "It's on the chair.", "correct": true}, {"nikud": "אֲנִי רָעֵב.", "ru": "Я голоден.", "en": "I'm hungry.", "correct": false}, {"nikud": "נֵלֵךְ בָּרַכֶּבֶת.", "ru": "Поедем на поезде.", "en": "We'll take the train.", "correct": false}]}, {"id": "elementary-people-d0", "level": "elementary", "theme": "people", "title": "Кто это", "titleEn": "Who is that", "lines": [{"speaker": "a", "nikud": "מִי זֹאת לְיָד דָּנִי?", "hebrew": "מי זאת ליד דני?", "transcription": "mi zot leyad dani?", "ru": "Кто это рядом с Дани?", "en": "Who is that next to Dani?"}, {"speaker": "b", "nikud": "זֹאת מָיָה, חֲבֵרָה שֶׁלִּי מֵהָעֲבוֹדָה.", "hebrew": "זאת מיה, חברה שלי מהעבודה.", "transcription": "zot maya, khavera shelli mehaavoda.", "ru": "Это Майя, подруга с работы.", "en": "That's Maya, a friend from work."}], "replies": [{"nikud": "נָעִים מְאֹד.", "ru": "Очень приятно.", "en": "Nice to meet you.", "correct": true}, {"nikud": "כַּמָּה זֶה עוֹלֶה?", "ru": "Сколько это стоит?", "en": "How much is that?", "correct": false}, {"nikud": "יֵשׁ פַּקָּק.", "ru": "Пробка.", "en": "There's traffic.", "correct": false}]}, {"id": "elementary-feelings-d0", "level": "elementary", "theme": "feelings", "title": "Как ты", "titleEn": "How you feel", "lines": [{"speaker": "a", "nikud": "אַתָּה בְּסֵדֶר? אַתָּה נִרְאֶה עָיֵף.", "hebrew": "אתה בסדר? אתה נראה עיף.", "transcription": "ata beseder? ata nire ayef.", "ru": "Ты в порядке? Выглядишь усталым.", "en": "Are you okay? You look tired."}, {"speaker": "b", "nikud": "קְצָת. הָיָה יוֹם אָרֹךְ.", "hebrew": "קצת. היה יום ארך.", "transcription": "ketsat. haya yom arokh.", "ru": "Немного. День был длинный.", "en": "A bit. It was a long day."}], "replies": [{"nikud": "לֵךְ לִישׁוֹן מֻקְדָּם הַיּוֹם.", "ru": "Ляг пораньше сегодня.", "en": "Go to sleep early today.", "correct": true}, {"nikud": "שְׁתֵּי חַפּוֹת.", "ru": "Две халы.", "en": "Two challahs.", "correct": false}, {"nikud": "הַמָּטוֹס בְּעֶשֶׂר.", "ru": "Самолёт в десять.", "en": "The plane is at ten.", "correct": false}]}, {"id": "elementary-daily-d0", "level": "elementary", "theme": "daily", "title": "Утро", "titleEn": "Morning", "lines": [{"speaker": "a", "nikud": "בֹּקֶר טוֹב. יֵשׁ קָפֶה?", "hebrew": "בקר טוב. יש קפה?", "transcription": "boker tov. yesh kafe?", "ru": "Доброе утро. Есть кофе?", "en": "Good morning. Is there coffee?"}, {"speaker": "b", "nikud": "כֵּן, עַל הַשֻּׁלְחָן. תִּרְצֶה גַּם לֶחֶם?", "hebrew": "כן, על השלחן. תרצה גם לחם?", "transcription": "ken, al hashulkhan. tirtse gam lekhem?", "ru": "Да, на столе. Хочешь ещё хлеб?", "en": "Yes, on the table. Want bread too?"}], "replies": [{"nikud": "כֵּן, תּוֹדָה רַבָּה.", "ru": "Да, большое спасибо.", "en": "Yes, thanks a lot.", "correct": true}, {"nikud": "אֲנִי גָּר בְּחֵיפָה.", "ru": "Я живу в Хайфе.", "en": "I live in Haifa.", "correct": false}, {"nikud": "זֶה אָדֹם.", "ru": "Это красное.", "en": "That's red.", "correct": false}]}, {"id": "elementary-abstract-d0", "level": "elementary", "theme": "abstract", "title": "Проще", "titleEn": "Keep it simple", "lines": [{"speaker": "a", "nikud": "זֶה מְסֻבָּךְ. יֵשׁ דֶּרֶךְ פְּשׁוּטָה?", "hebrew": "זה מסבך. יש דרך פשוטה?", "transcription": "ze mesubakh. yesh derekh peshuta?", "ru": "Это сложно. Есть простой способ?", "en": "This is complicated. Is there a simple way?"}, {"speaker": "b", "nikud": "כֵּן. נַעֲשֶׂה אֶת זֶה לְאַט.", "hebrew": "כן. נעשה את זה לאט.", "transcription": "ken. naase et ze leat.", "ru": "Да. Сделаем это медленно.", "en": "Yes. We'll do it slowly."}], "replies": [{"nikud": "טוֹב, בּוֹא נַתְחִיל.", "ru": "Хорошо, давай начнём.", "en": "Good, let's start.", "correct": true}, {"nikud": "כַּרְטִיס לְתֵל אָבִיב.", "ru": "Билет в Тель-Авив.", "en": "A ticket to Tel Aviv.", "correct": false}, {"nikud": "כְּאֵב לִי הָרֹאשׁ.", "ru": "У меня болит голова.", "en": "I have a headache.", "correct": false}]}, {"id": "elementary-body-d0", "level": "elementary", "theme": "body", "title": "Болит голова", "titleEn": "Headache", "lines": [{"speaker": "a", "nikud": "מָה קָרָה? אַתָּה חִוֵּר.", "hebrew": "מה קרה? אתה חור.", "transcription": "ma kara? ata khiver.", "ru": "Что случилось? Ты бледный.", "en": "What happened? You're pale."}, {"speaker": "b", "nikud": "כְּאֵב לִי הָרֹאשׁ. יֵשׁ מַיִם?", "hebrew": "כאב לי הראש. יש מים?", "transcription": "keev li harosh. yesh mayim?", "ru": "Голова болит. Есть вода?", "en": "My head hurts. Is there water?"}], "replies": [{"nikud": "הִנֵּה, וְשֵׁב רֶגַע.", "ru": "Вот, и сядь на секунду.", "en": "Here, and sit for a moment.", "correct": true}, {"nikud": "הַמִּכְנָסַיִם כְּחוּלִים.", "ru": "Брюки синие.", "en": "The trousers are blue.", "correct": false}, {"nikud": "נִסַּע בַּמְּכוֹנִית.", "ru": "Поедем на машине.", "en": "We'll go by car.", "correct": false}]}, {"id": "elementary-city-d0", "level": "elementary", "theme": "city", "title": "Где остановка", "titleEn": "Where is the stop", "lines": [{"speaker": "a", "nikud": "סְלִיחָה, אֵיפֹה תַּחֲנַת הָאוֹטוֹבּוּס?", "hebrew": "סליחה, איפה תחנת האוטובוס?", "transcription": "selikha, efo takhanat haotobus?", "ru": "Извините, где автобусная остановка?", "en": "Excuse me, where is the bus stop?"}, {"speaker": "b", "nikud": "יָשָׁר וְאַחַר כָּךְ יָמִינָה.", "hebrew": "ישר ואחר כך ימינה.", "transcription": "yashar veakhar kakh yamina.", "ru": "Прямо и потом направо.", "en": "Straight and then right."}], "replies": [{"nikud": "תּוֹדָה רַבָּה!", "ru": "Большое спасибо!", "en": "Thanks a lot!", "correct": true}, {"nikud": "אֲנִי רוֹצֶה מָרָק.", "ru": "Хочу суп.", "en": "I want soup.", "correct": false}, {"nikud": "זֶה אָח שֶׁלִּי.", "ru": "Это мой брат.", "en": "That's my brother.", "correct": false}]}, {"id": "elementary-family-d0", "level": "elementary", "theme": "family", "title": "Семья в гостях", "titleEn": "Family visiting", "lines": [{"speaker": "a", "nikud": "אִמָּא בָּאָה הַיּוֹם. אַבָּא גַּם?", "hebrew": "אמא באה היום. אבא גם?", "transcription": "imma baa haom. aba gam?", "ru": "Мама сегодня приходит. Папа тоже?", "en": "Mom is coming today. Dad too?"}, {"speaker": "b", "nikud": "כֵּן, וְגַם אָחוֹת שֶׁלִּי.", "hebrew": "כן, וגם אחות שלי.", "transcription": "ken, vegam akhot shelli.", "ru": "Да, и моя сестра тоже.", "en": "Yes, and my sister too."}], "replies": [{"nikud": "יוֹפִי, נָכִין אֹכֶל.", "ru": "Отлично, приготовим еду.", "en": "Great, we'll make food.", "correct": true}, {"nikud": "הָרַכֶּבֶת מְאֻחֶרֶת.", "ru": "Поезд опаздывает.", "en": "The train is late.", "correct": false}, {"nikud": "כָּחוֹל אוֹ אָדֹם?", "ru": "Синий или красный?", "en": "Blue or red?", "correct": false}]}, {"id": "elementary-time-d0", "level": "elementary", "theme": "time", "title": "Во сколько", "titleEn": "What time", "lines": [{"speaker": "a", "nikud": "מָתַי אֲנַחְנוּ נִפְגָּשִׁים?", "hebrew": "מתי אנחנו נפגשים?", "transcription": "mata anakhnu nifgashim?", "ru": "Когда встречаемся?", "en": "When are we meeting?"}, {"speaker": "b", "nikud": "בְּשֵׁשׁ. זֶה בְּסֵדֶר?", "hebrew": "בשש. זה בסדר?", "transcription": "beshesh. ze beseder?", "ru": "В шесть. Нормально?", "en": "At six. Is that okay?"}], "replies": [{"nikud": "בְּסֵדֶר, אֲנִי אֶהְיֶה שָׁם.", "ru": "Ладно, я буду там.", "en": "Okay, I'll be there.", "correct": true}, {"nikud": "זֶה הַכֶּלֶב שֶׁלִּי.", "ru": "Это моя собака.", "en": "That's my dog.", "correct": false}, {"nikud": "אֲנִי לֹא אוֹהֵב דָּג.", "ru": "Я не люблю рыбу.", "en": "I don't like fish.", "correct": false}]}, {"id": "elementary-school-d0", "level": "elementary", "theme": "school", "title": "Урок", "titleEn": "Class", "lines": [{"speaker": "a", "nikud": "יֵשׁ שִׁעוּר הַיּוֹם?", "hebrew": "יש שעור היום?", "transcription": "yesh shiur haom?", "ru": "Сегодня есть урок?", "en": "Is there class today?"}, {"speaker": "b", "nikud": "כֵּן, בְּעֶשֶׂר. הֵבֵאתָ אֶת הַסֵּפֶר?", "hebrew": "כן, בעשר. הבאת את הספר?", "transcription": "ken, beeser. heveta et hasefer?", "ru": "Да, в десять. Книгу взял?", "en": "Yes, at ten. Did you bring the book?"}], "replies": [{"nikud": "כֵּן, הוּא בַּתִּיק.", "ru": "Да, она в сумке.", "en": "Yes, it's in the bag.", "correct": true}, {"nikud": "תָּבִיא חֶשְׁבּוֹן.", "ru": "Принеси счёт.", "en": "Bring the bill.", "correct": false}, {"nikud": "יֵשׁ גֶּשֶׁם.", "ru": "Дождь.", "en": "It's raining.", "correct": false}]}, {"id": "elementary-food-d0", "level": "elementary", "theme": "food", "title": "В кафе", "titleEn": "At a café", "lines": [{"speaker": "a", "nikud": "שָׁלוֹם, אֶפְשָׁר קָפֶה וְחַלָּה?", "hebrew": "שלום, אפשר קפה וחלה?", "transcription": "shalom, efshar kafe vekhalla?", "ru": "Здравствуйте, можно кофе и халу?", "en": "Hi, can I have coffee and a pastry?"}, {"speaker": "b", "nikud": "בֶּטַח. לִשְׁתּוֹת פֹּה אוֹ לָקַחַת?", "hebrew": "בטח. לשתות פה או לקחת?", "transcription": "betakh. lishtot po o lakakhat?", "ru": "Конечно. Здесь или с собой?", "en": "Sure. For here or to go?"}], "replies": [{"nikud": "לִשְׁתּוֹת פֹּה, תּוֹדָה.", "ru": "Здесь, спасибо.", "en": "For here, thanks.", "correct": true}, {"nikud": "אֲנִי גָּר רָחוֹק.", "ru": "Я живу далеко.", "en": "I live far away.", "correct": false}, {"nikud": "זֶה הַמַּפְתֵּחַ?", "ru": "Это ключ?", "en": "Is this the key?", "correct": false}]}, {"id": "elementary-numbers-d0", "level": "elementary", "theme": "numbers", "title": "Два билета", "titleEn": "Two tickets", "lines": [{"speaker": "a", "nikud": "שְׁנֵי כַּרְטִיסִים לְחֵיפָה, בְּבַקָּשָׁה.", "hebrew": "שני כרטיסים לחיפה, בבקשה.", "transcription": "shene kartisim lekhefa, bevakasha.", "ru": "Два билета в Хайфу, пожалуйста.", "en": "Two tickets to Haifa, please."}, {"speaker": "b", "nikud": "בְּסֵדֶר. זֶה אַרְבָּעִים שְׁקָלִים.", "hebrew": "בסדר. זה ארבעים שקלים.", "transcription": "beseder. ze arbaim shekalim.", "ru": "Хорошо. Это сорок шекелей.", "en": "Okay. That's forty shekels."}], "replies": [{"nikud": "הִנֵּה, תּוֹדָה.", "ru": "Вот, спасибо.", "en": "Here, thanks.", "correct": true}, {"nikud": "אֲנִי עָיֵף.", "ru": "Я устал.", "en": "I'm tired.", "correct": false}, {"nikud": "פְּתַח אֶת הַחַלּוֹן.", "ru": "Открой окно.", "en": "Open the window.", "correct": false}]}, {"id": "elementary-news-d0", "level": "elementary", "theme": "news", "title": "Ты слышал", "titleEn": "Did you hear", "lines": [{"speaker": "a", "nikud": "שָׁמַעְתָּ אֶת הַחֲדָשׁוֹת הַבֹּקֶר?", "hebrew": "שמעת את החדשות הבקר?", "transcription": "shamata et hakhadashot haboker?", "ru": "Слышал утренние новости?", "en": "Did you hear the news this morning?"}, {"speaker": "b", "nikud": "לֹא. מָה קָרָה?", "hebrew": "לא. מה קרה?", "transcription": "lo. ma kara?", "ru": "Нет. Что случилось?", "en": "No. What happened?"}], "replies": [{"nikud": "סַפֵּר לִי אַחַר כָּךְ, אֲנִי מְמַהֵר.", "ru": "Расскажи потом, я спешу.", "en": "Tell me later, I'm in a hurry.", "correct": true}, {"nikud": "כּוֹס חָלָב.", "ru": "Стакан молока.", "en": "A glass of milk.", "correct": false}, {"nikud": "הַנָּעֲ
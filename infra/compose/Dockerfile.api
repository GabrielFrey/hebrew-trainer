FROM python:3.12-slim
WORKDIR /app
COPY apps/api/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY apps/api /app
COPY packages/grading /packages/grading
ENV PYTHONPATH=/app
EXPOSE 43180
CMD ["uvicorn", "biti.main:app", "--host", "0.0.0.0", "--port", "43180"]
